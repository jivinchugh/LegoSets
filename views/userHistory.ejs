<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lego</title>
</head>

<body>
    <%- include('partials/navbar', {page:''}) %>

    <div class="container mx-auto p-4">
      <div class="hero bg-base-200 rounded-lg p-6">
        <div class="hero-content text-center">
          <div class="max-w-md">
            <h1 class="text-5xl font-bold">User History</h1>
            <% if (session.user) { %>
              <p>Username: <%= session.user.userName %>
              </p>
              <p>Email: <%= session.user.email %>
              </p>
              <% } %>
          </div>
        </div>
      </div>

      <% if (session.user && session.user.loginHistory) { %>
        
        <table class="user-history-table">
          <thead>
            <tr>
              <th>Login Date/Time</th>
              <th>Client Information</th>
            </tr>
          </thead>

          <tbody>
            <% session.user.loginHistory.forEach(function(history) { %>
              <tr>
                <td>
                  <%= history.dateTime %>
                </td>
                <td>
                  <%= history.userAgent %>
                </td>
              </tr>
              <% }); %>
          </tbody>

        </table>
        
        <% } else { %>
          <p>not available</p>
          <% } %>
    </div>
</body>

</html>