<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/css/main.css">


    <title>Lego Collection</title>
</head>

<body>

    <%- include('partials/navbar', {page: ""}) %>
    <div class="hero">
        <div class="hero-content text-center">
            <div class="max-w-md">
                <h1 class="text-5xl font-bold">HOLA AMIGOS!</h1>
                <p class="py-6">Here is a collection where you can find and learn about variety of lego sets!!</p>
                <a href="/lego/sets" class="btn btn-primary">SHOW LIST OF LEGO SETS</a>
            </div>
        </div>
    </div>


    <div class="grid grid-cols-3 gap-4">
        <div class="card w-50 bg-base-100 shadow-xl">
            <figure><img src="https://cdn.rebrickable.com/media/sets/10037-1.jpg" alt="Shoes" /></figure>
            <div class="card-body">
                <h2 class="card-title">Breezeway Cafe</h2>
                <p>Release date : 1990</p>
                <div class="card-actions justify-end">
                    <a href="/lego/sets/10037-1" class="btn btn-primary">LOOK!</a>
                </div>
            </div>
        </div>

        <div class="card w-50 bg-base-100 shadow-xl">
            <figure><img src="https://cdn.rebrickable.com/media/sets/10039-1.jpg" alt="Shoes" /></figure>
            <div class="card-body">
                <h2 class="card-title">Black Falcon's Fortress</h2>
                <p>Release date : 1986</p>
                <div class="card-actions justify-end">
                    <a href="/lego/sets/10039-1" class="btn btn-primary">LOOK!</a>
                </div>
            </div>
        </div>

        <div class="card w-50 bg-base-100 shadow-xl">
            <figure><img src="https://cdn.rebrickable.com/media/sets/10040-1.jpg" alt="Shoes" /></figure>
            <div class="card-body">
                <h2 class="card-title">Black Seas Barracuda</h2>
                <p>If a dog chews shoes whose shoes does he choose?</p>
                <div class="card-actions justify-end">
                    <a href="/lego/sets/10040-1" class="btn btn-primary">LOOK!</a>
                </div>
            </div>
        </div>
    </div>

</body>

</html>